{
  "manifestVersion": 1,
  "id": "orca-autopilot",
  "publisher": "minhdn3",
  "name": "Orca AutoPilot",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent Kanban & Pipeline Engine compatible with mattpocock/skills",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "autopilot-kanban",
        "title": "Agent Fleet & Kanban",
        "icon": "bot",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "autopilot-sync",
        "title": "AutoPilot: Sync Issues & Skills"
      },
      {
        "id": "autopilot-run-all",
        "title": "AutoPilot: Run Autonomous Pipeline"
      }
    ],
    "events": [
      {
        "on": "worktree.created"
      },
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage"
    },
    {
      "kind": "events:subscribe"
    }
  ]
}
